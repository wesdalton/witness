    "type": "function",
    "function": {
      "name": "submit",
      "description": "Submit the audit verdict.",
      "parameters": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "refuted",
              "insufficient"
            ]
          },
          "p_claim_true": {
            "type": "number"
          },
          "evidence_used": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "report",
                "artifacts",
                "manifest",
                "replay"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "p_claim_true",
          "evidence_used",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
